# VERIDION Coolify boot-safe initial availability example
# Use with /docker-compose.yml or /deploy/docker-compose.coolify.yml only.
# This profile keeps the public site reachable before PostgreSQL, Redis, R2 and paid-service cutover are configured.
# For strict commercial deployment, switch to deploy/docker-compose.commercial.yml and generate values with:
# npm run generate:r2-env
NODE_ENV=production
HOST=0.0.0.0
PORT=3210
NV0_PLATFORM_TARGET=mvp
NV0_DEPLOYMENT_STAGE=mvp
NV0_COMMERCIAL_LAUNCH_READY=false
NV0_RUN_PREFLIGHT=false
NV0_EXPOSE_INTERNAL_PUBLIC_APIS=false
NV0_PAYMENT_PROVIDER=disabled
# Keep empty while payments are disabled. Set explicit trusted hosts only during approved commercial cutover.
NV0_PAYMENT_REDIRECT_ALLOWED_HOSTS=
NV0_SESSION_SECRET=replace-with-long-random-session-secret
NV0_SECURE_RECORDS_KEY=replace-with-long-random-secure-records-key
NV0_PRIVACY_HASH_KEY=replace-with-long-random-privacy-hash-key
NV0_TARGET_FETCH_ENABLED=false

# 관리자 2차 인증
NV0_ADMIN_MFA_REQUIRED=true
NV0_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
