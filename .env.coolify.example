# VERIDION Coolify production example
# Copy the full production template from deploy/coolify.env.example and replace placeholders in Coolify.
NODE_ENV=production
HOST=0.0.0.0
PORT=3210
NV0_DEPLOYMENT_STAGE=production
NV0_COMMERCIAL_LAUNCH_READY=false
NV0_EXPOSE_INTERNAL_PUBLIC_APIS=false
NV0_PAYMENT_PROVIDER=demo
NV0_PAYMENT_REDIRECT_ALLOWED_HOSTS=
NV0_ADMIN_KEY=replace-with-long-random-admin-key
NV0_SESSION_SECRET=replace-with-long-random-session-secret
NV0_SECURE_RECORDS_KEY=replace-with-long-random-secure-records-key
NV0_PRIVACY_HASH_KEY=replace-with-long-random-privacy-hash-key
