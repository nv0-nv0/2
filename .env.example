# NV0 / Veridion commercial launch environment (.env.example)
NODE_ENV=production
HOST=0.0.0.0
PORT=3210
NV0_PLATFORM_TARGET=commercial
NV0_PUBLIC_BASE_URL=https://nv0.kr
NV0_TRUST_PROXY_HEADERS=true
NV0_ALLOWED_ADMIN_ORIGINS=nv0.kr,www.nv0.kr

# Auth / RBAC
NV0_ADMIN_AUTH_MODE=account_rbac
NV0_BOOTSTRAP_ADMIN_EMAIL=admin@your-production-domain.kr
NV0_BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-password
NV0_ADMIN_SESSION_TTL_MS=3600000
NV0_ENABLE_TURNSTILE=true
NV0_TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret
NV0_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Persistence
NV0_PERSISTENCE_MODE=postgres_primary
NV0_DATABASE_URL=postgres://user:password@postgres:5432/nv0
NV0_DB_COMPARE_MODE=0

# Redis-backed stateless operation
NV0_REDIS_URL=redis://redis:6379/0
NV0_SESSION_STORE=redis
NV0_RATE_LIMIT_STORE=redis
NV0_LOCK_PROVIDER=redis

# Object storage / S3 compatible
NV0_STORAGE_MODE=s3
NV0_S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
NV0_S3_BUCKET=replace-with-bucket
NV0_S3_REGION=ap-northeast-2
NV0_S3_ACCESS_KEY_ID=replace-with-access-key
NV0_S3_SECRET_ACCESS_KEY=replace-with-secret-key
NV0_S3_PUBLIC_BASE_URL=https://cdn.your-production-domain.kr

# External scan provider
NV0_SCAN_PROVIDER=external_http
NV0_SCAN_PROVIDER_URL=https://scan.your-production-domain.kr/api/scan
NV0_SCAN_PROVIDER_TOKEN=replace-with-scan-token
NV0_SCAN_PROVIDER_FALLBACK=false
NV0_TARGET_FETCH_ENABLED=false

# PortOne V2
NV0_PAYMENT_PROVIDER=portone_v2
NV0_PORTONE_API_SECRET=replace-with-portone-api-secret
NV0_PORTONE_STORE_ID=replace-with-portone-store-id
NV0_PORTONE_CHANNEL_KEY=replace-with-portone-channel-key
NV0_PORTONE_WEBHOOK_SECRET=replace-with-portone-webhook-secret
NV0_PORTONE_WEBHOOK_VERIFY_MODE=strict

# Limits
NV0_PUBLIC_SCAN_LIMIT=20
NV0_PUBLIC_SCAN_WINDOW_MS=60000
NV0_ADMIN_AUTH_LIMIT=8
NV0_ADMIN_AUTH_WINDOW_MS=600000
NV0_BACKUP_RETENTION_COUNT=20
NV0_AUDIT_LOG_RETENTION_COUNT=1000


NV0_SUPPORT_EMAIL=ct@nv0.kr

# Phase37 legal/commercial disclosure fields
NV0_MAIL_ORDER_REGISTRATION_NUMBER=제0000-서울중구-0000호
NV0_HOSTING_PROVIDER=replace-with-hosting-provider
NV0_CUSTOMER_SERVICE_PHONE=replace-with-customer-service-phone
NV0_PRIVACY_OFFICER_EMAIL=privacy@nv0.kr

# Phase38 operational hardening
NV0_PAYMENT_IDEMPOTENCY_TTL_MS=86400000
NV0_EMAIL_MAX_RETRY_COUNT=5
NV0_EMAIL_RETRY_BACKOFF_MS=300000
NV0_ADMIN_IP_ALLOWLIST=replace-with-admin-static-ip
NV0_PUBLIC_CACHE_SECONDS=60
NV0_SMTP_URL=smtps://user:password@smtp.your-production-domain.kr:465?from=ct%40nv0.kr
