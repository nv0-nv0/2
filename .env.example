# NV0 commercial production environment example
# Copy values into Coolify > Resource > Environment Variables > Developer View.
# Do not commit real secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=3210
NV0_RUNTIME_DIR=/tmp/nv0-runtime
NV0_FALLBACK_RUNTIME_DIR=/tmp/nv0-runtime
NV0_REQUIRE_PERSISTENT_RUNTIME=auto
NV0_PLATFORM_TARGET=commercial
NV0_DEPLOYMENT_STAGE=prelaunch
NV0_COMMERCIAL_LAUNCH_READY=false
NV0_ALLOW_PRELAUNCH_ONLINE_PAYMENT=false
NV0_PUBLIC_BASE_URL=https://www.nv0.kr
NV0_CANONICAL_HOST_REDIRECT=false
NV0_REDIRECT_OWNER=edge
NV0_DEPLOYMENT_RISK_STRICT=false
# PHASE223: 현재 운영은 edge(Cloudflare/Coolify)가 apex/www 리다이렉트를 담당하고, 앱 canonical redirect는 false로 둡니다.
NV0_TRUST_PROXY_HEADERS=true
NV0_ALLOWED_ADMIN_ORIGINS=nv0.kr,www.nv0.kr
NV0_ALLOWED_HOSTS=nv0.kr,www.nv0.kr
NV0_REQUEST_TIMEOUT_MS=15000
NV0_SLOW_REQUEST_THRESHOLD_MS=1500
NV0_ACCESS_LOG_MODE=normal
NV0_LOG_HEALTHCHECK_REQUESTS=false
NV0_LOG_FAVICON_REQUESTS=false
NV0_MAX_JSON_BODY_BYTES=1048576
NV0_MAX_MULTIPART_BODY_BYTES=10485760
NV0_SUPPORT_EMAIL=ct@nv0.kr
NV0_MAIL_ORDER_REGISTRATION_NUMBER=
NV0_HOSTING_PROVIDER=Coolify/Contabo
NV0_CUSTOMER_SERVICE_PHONE=이메일 전용 고객지원
NV0_PRIVACY_OFFICER_EMAIL=privacy@nv0.kr
NV0_DATA_RETENTION_DAYS=90
NV0_DATA_DESTRUCTION_GRACE_DAYS=30
NV0_REFUND_REQUEST_WINDOW_DAYS=7
NV0_RULES_VERSION=production-20260427
NV0_OPERATOR_ALERT_EMAIL=ct@nv0.kr
NV0_ADMIN_AUTH_MODE=account_rbac
NV0_BOOTSTRAP_ADMIN_EMAIL=admin@nv0.kr
NV0_BOOTSTRAP_ADMIN_NAME=VERIDION_Admin
NV0_BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-admin-password
NV0_ADMIN_SESSION_TTL_MS=3600000
NV0_ADMIN_IP_ALLOWLIST=replace-with-admin-static-ip-or-cidr
NV0_ENABLE_TURNSTILE=true
NV0_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
NV0_TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret
POSTGRES_DB=nv0
POSTGRES_USER=nv0
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
NV0_PERSISTENCE_MODE=postgres_primary
NV0_DATABASE_URL=postgres://nv0:replace-with-long-random-postgres-password@postgres:5432/nv0
PGSSLMODE=disable
NV0_DB_COMPARE_MODE=0
NV0_REDIS_URL=redis://redis:6379/0
NV0_REDIS_TIMEOUT_MS=1500
NV0_READYZ_REDIS_STRICT=false
NV0_READYZ_CACHE_TTL_MS=3000
NV0_SESSION_STORE=redis
NV0_RATE_LIMIT_STORE=redis
NV0_LOCK_PROVIDER=redis
NV0_STORAGE_MODE=s3
NV0_S3_ENDPOINT=https://R2_ACCOUNT_ID.r2.cloudflarestorage.com
NV0_S3_BUCKET=nv0-production
NV0_S3_REGION=auto
NV0_S3_ACCESS_KEY_ID=R2_ACCESS_KEY_ID
NV0_S3_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY
NV0_S3_PUBLIC_BASE_URL=
NV0_S3_FORCE_PATH_STYLE=true
NV0_SCAN_PROVIDER=builtin
NV0_SCAN_PROVIDER_URL=https://scan.nv0.kr/api/scan
NV0_SCAN_PROVIDER_TOKEN=replace-with-scan-token
NV0_SCAN_PROVIDER_FALLBACK=true
NV0_SCAN_CACHE_TTL_MS=300000
NV0_TARGET_FETCH_ENABLED=true
NV0_TARGET_FETCH_MAX_PAGES=12
NV0_TARGET_FETCH_CONCURRENCY=4
NV0_TARGET_FETCH_TIMEOUT_MS=3000
NV0_TARGET_FETCH_ROBOTS_ENABLED=true
NV0_TARGET_FETCH_SITEMAP_ENABLED=true
NV0_TARGET_FETCH_MAX_SITEMAP_URLS=40
NV0_TARGET_FETCH_MAX_DISCOVERY_RESOURCES=4
NV0_TARGET_FETCH_AUTOMATION_LEVEL=maximum_free_safe
NV0_PAYMENT_PROVIDER=portone_v2
NV0_PORTONE_API_BASE_URL=https://api.portone.io
NV0_PORTONE_API_SECRET=
NV0_PORTONE_STORE_ID=
NV0_PORTONE_CHANNEL_KEY=
NV0_PORTONE_REDIRECT_URL=https://nv0.kr/checkout
NV0_PORTONE_PAY_METHOD=CARD
NV0_PORTONE_CUSTOMER_ID_PREFIX=nv0
NV0_PORTONE_WEBHOOK_SECRET=
NV0_PORTONE_WEBHOOK_VERIFY_MODE=strict
NV0_SMTP_URL=smtps://user:password@smtp.your-provider.kr:465?from=ct%40nv0.kr
NV0_EMAIL_MAX_RETRY_COUNT=5
NV0_EMAIL_RETRY_BACKOFF_MS=300000
NV0_PUBLIC_SCAN_LIMIT=20
NV0_PUBLIC_SCAN_WINDOW_MS=60000
NV0_ADMIN_AUTH_LIMIT=8
NV0_ADMIN_AUTH_WINDOW_MS=600000
NV0_BACKUP_RETENTION_COUNT=20
NV0_BACKUP_REMOTE_ENABLED=true
NV0_BACKUP_REMOTE_PREFIX=backups/nv0
NV0_BACKUP_COMPRESS=true
NV0_BACKUP_ENCRYPTION_SECRET=CHANGE_ME_LONG_RANDOM_BACKUP_SECRET
NV0_BACKUP_REMOTE_REQUIRE_ENCRYPTION=true
NV0_AUTO_BACKUP_ENABLED=true
NV0_AUTO_BACKUP_ON_STARTUP=true
NV0_AUTO_BACKUP_INTERVAL_MS=21600000
NV0_AUDIT_LOG_RETENTION_COUNT=1000
NV0_PAYMENT_IDEMPOTENCY_TTL_MS=86400000
NV0_PUBLIC_CACHE_SECONDS=60
NV0_PUBLIC_ASSET_CACHE_SECONDS=31536000
NV0_CTA_AUTOPUBLISH_INTERVAL_MS=1200000
NV0_RUN_PREFLIGHT=true

# PHASE136 secure user/payment record storage
# Required in commercial mode: encrypt separated customer/order/payment/audit records at rest.
NV0_SECURE_RECORDS_KEY=
NV0_SECURE_RECORDS_SALT=nv0-secure-record-store-v1
NV0_SECURE_RECORDS_DIR=runtime/data/secure-records
# PHASE160 evidence-first AI review layer (optional; Gemini is interpretive only, not a measurement source)
NV0_AI_REVIEW_PROVIDER=disabled
NV0_GEMINI_API_KEY=
NV0_GEMINI_MODEL=gemini-2.5-flash


# PHASE200 commercial system hardening
NV0_COMMERCIAL_ENV_STRICT=false
NV0_PHASE200_AUDIT_JSONL=runtime/reports/audit.phase200.jsonl
NV0_ORDER_WEBHOOK_REPLAY_ENABLED=true
NV0_DIAGNOSIS_RULES_VERSION=nv0-rules-2026.05.phase200


# PHASE287 actual commercial launch gates
# These values are intentionally false/blank by default. Set them only after real legal/payment/ops verification.
NV0_POLICY_VERSION=phase287-legal-payment-ops-v1
NV0_LEGAL_REVIEW_APPROVED=false
NV0_LEGAL_REVIEW_APPROVER=
NV0_LEGAL_REVIEWED_AT=
NV0_PAYMENT_LIVE_READY=false
NV0_PAYMENT_LIVE_TEST_ORDER_ID=
NV0_PAYMENT_REFUND_TEST_APPROVED=false
NV0_PAYMENT_WEBHOOK_LIVE_VERIFIED=false
NV0_OPS_LIVE_READY=false
NV0_BACKUP_RESTORE_DRILL_APPROVED=false
NV0_INCIDENT_RESPONSE_DRILL_APPROVED=false
NV0_MONITORING_DASHBOARD_URL=
NV0_STATUS_PAGE_URL=
NV0_LAUNCH_GO_NO_GO_OWNER=
