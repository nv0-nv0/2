# VERIDION local development environment example
# Copy to .env and replace placeholder values only when needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3210
NV0_RUNTIME_DIR=./runtime
NV0_FALLBACK_RUNTIME_DIR=./runtime
NV0_PLATFORM_TARGET=mvp
NV0_DEPLOYMENT_STAGE=development
NV0_COMMERCIAL_LAUNCH_READY=false
# Test-only internal operational API switch. Keep false outside controlled integration tests.
NV0_EXPOSE_INTERNAL_PUBLIC_APIS=false
NV0_PUBLIC_BASE_URL=http://127.0.0.1:3210
NV0_PAYMENT_PROVIDER=demo
NV0_PAYMENT_REDIRECT_ALLOWED_HOSTS=
NV0_ADMIN_KEY=replace-with-local-admin-key
NV0_SESSION_SECRET=replace-with-long-random-session-secret
NV0_SECURE_RECORDS_KEY=replace-with-long-random-secure-records-key
NV0_PRIVACY_HASH_KEY=replace-with-long-random-privacy-hash-key
NV0_SCAN_PROVIDER=builtin
NV0_SCAN_PROVIDER_FALLBACK=true
NV0_TARGET_FETCH_ENABLED=false
NV0_ENABLE_TURNSTILE=false
NV0_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
NV0_TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret
NV0_PORTONE_API_SECRET=replace-with-portone-api-secret
NV0_PORTONE_WEBHOOK_SECRET=replace-with-portone-webhook-secret
NV0_GEMINI_API_KEY=replace-with-optional-gemini-api-key
# Production templates: deploy/env.production.nv0.kr.example and deploy/coolify.env.example

# Optional local safety and timeout controls
NV0_HEALTHZ_STRICT=false
NV0_READYZ_CACHE_TTL_MS=3000
# Browser cache: public HTML revalidates quickly; versioned CSS/JS can stay immutable for one year.
NV0_PUBLIC_CACHE_SECONDS=0
NV0_PUBLIC_ASSET_CACHE_SECONDS=0
NV0_SCAN_SOFT_TIMEOUT_MS=6500
NV0_PUBLIC_DEMO_FORCE_SCAN_FALLBACK=true
NV0_TARGET_FETCH_MAX_BYTES=524288
NV0_TARGET_FETCH_MAX_REDIRECTS=3
NV0_ALLOW_PRELAUNCH_ONLINE_PAYMENT=false
NV0_PAYMENT_PROVIDER_URL=
NV0_PAYMENT_PROVIDER_TOKEN=

# 관리자 2차 인증
NV0_ADMIN_MFA_REQUIRED=true
NV0_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
# auto: prelaunch holds safely on invalid TOTP; commercial_launch exits fail-closed.
NV0_TOTP_PREFLIGHT_FAILURE_MODE=auto
NV0_PREFLIGHT_FAILURE_DELAY_SECONDS=15
